# Copy to .env.local for local dev; set the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (the publishable key, or the legacy anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only this address can sign in (single-user app).
ALLOWED_EMAIL=

# Length of the email sign-in code (Supabase → Auth → Providers → Email → OTP length).
NEXT_PUBLIC_OTP_LENGTH=6

# Optional: canonical site URL used in magic links (defaults to the request host).
NEXT_PUBLIC_SITE_URL=

# Vercel sends this as a Bearer token to the cron endpoint. Any long random string.
CRON_SECRET=

# Server-only AI keys (Phase 4). Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
GEMINI_API_KEY=
